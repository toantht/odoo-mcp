# LibreChat env for the odoo-mcp deployment (blueprint-librechat.md).
# Copy to .env (git-ignored) and fill in. This is LibreChat's own config -
# separate from the gateway's .env at the repo root.

HOST=0.0.0.0
PORT=3080

# Public origin users load LibreChat from, and the origin LibreChat tells
# OAuth providers (including this gateway) to redirect back to. Both the
# same value for a single-domain deployment. The MCP callback this
# gateway will see registered is
# ${DOMAIN_SERVER}/api/mcp/<server_id>/oauth/callback - add that host to
# the *gateway's* ODOO_MCP_OAUTH_REDIRECT_HOSTS (not set here; see
# .env.example at the repo root). localhost/127.0.0.1 are already
# allowed by the gateway, so a local trial on this default needs no
# extra gateway config.
DOMAIN_CLIENT=http://localhost:3080
DOMAIN_SERVER=http://localhost:3080

# Keep registration closed - every account here spends this instance's
# shared Anthropic key even before that user ever consents to an Odoo
# connector. Flip to true only long enough to create known accounts,
# then set back to false and restart.
ALLOW_REGISTRATION=false

# Claude API. This key is LibreChat's own - unrelated to any Odoo API
# key created via MCP consent.
ENDPOINTS=anthropic
ANTHROPIC_API_KEY=

# Required for LibreChat's own search index (Meilisearch). Generate
# with e.g. `python -c "import secrets; print(secrets.token_hex(16))"`.
MEILI_MASTER_KEY=

# Encrypts LibreChat sessions and MCP OAuth tokens stored in Mongo.
# Generate once and keep these values. They must stay unchanged across
# container recreates; rotating them disconnects every MCP server until
# each user authenticates again.
# `python -c "import secrets; print(secrets.token_hex(32))"`
# CREDS_IV is 16 bytes: token_hex(16). The other three are token_hex(32).
JWT_SECRET=
JWT_REFRESH_SECRET=
CREDS_KEY=
CREDS_IV=
