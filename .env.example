ODOO_API_KEY=

# Option A (Phase 5+): pick a server from config/servers.yaml
# (copy config/servers.example.yaml -> config/servers.yaml first).
ODOO_MCP_SERVER=
# Only needed if servers.yaml lives somewhere other than config/servers.yaml
ODOO_MCP_CONFIG=

# Option B (Phase 2-4, no registry file): set these instead, and leave
# ODOO_MCP_SERVER blank.
ODOO_URL=
# Only needed if the server hosts multiple databases (json2) - required
# for xmlrpc (no multi-db header there).
ODOO_DB=
# Phase 8, xmlrpc backend only (Odoo <=18): username/email to log in
# with. Not needed for json2 (the bearer API key is the whole identity).
ODOO_LOGIN=

# Phase 9 (Option B only - no registry/ODOO_MCP_SERVER): comma-separated
# allowlist of write tool names to expose, e.g. create_partner. Empty
# (default) means no write tools - write access is opt-in. With Option
# A, use servers.yaml's `write_tools:` field instead of this.
ODOO_MCP_WRITE_TOOLS=

# Phase 12 (odoo-mcp-http only): OAuth consent via each Odoo server's own
# addon/odoo_mcp, instead of one shared ODOO_API_KEY for every caller.
# On by default - leave the block below filled in for a real HTTP
# deployment. Set ODOO_MCP_ALLOW_SHARED_KEY=1 instead to go back to the
# single-ODOO_API_KEY model (e.g. for scripts/smoke_mcp_http.py).
ODOO_MCP_ALLOW_SHARED_KEY=

# Public https URL this gateway is reachable at - also the OAuth issuer
# Claude sees. Required unless ODOO_MCP_ALLOW_SHARED_KEY=1.
ODOO_MCP_PUBLIC_URL=
# Long random secret used to encrypt Odoo API keys at rest in the vault
# (config/vault.sqlite3, git-ignored). Required unless
# ODOO_MCP_ALLOW_SHARED_KEY=1. Generate with e.g.
# `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
ODOO_MCP_VAULT_KEY=
# Optional - defaults to config/vault.sqlite3.
ODOO_MCP_VAULT_PATH=
# Optional extra hosts (comma-separated) allowed in a Claude-registered
# redirect_uri, beyond the built-in claude.ai/localhost/127.0.0.1. Add
# a self-host MCP client's hostname here too, e.g. a LibreChat deploy
# (see deploy/librechat/, blueprint-librechat.md):
# ODOO_MCP_OAUTH_REDIRECT_HOSTS=chat.example.com
ODOO_MCP_OAUTH_REDIRECT_HOSTS=

# One per server in servers.yaml, <SERVER_ID> upper-cased - must match
# that server's Settings > MCP Gateway > "MCP Channel Secret"
# (odoo_mcp.channel_secret) exactly. Example for a server id "odoo_a":
# ODOO_MCP_CHANNEL_SECRET_ODOO_A=